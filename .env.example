# ---------------------------------------------------------------- GitLab
GITLAB_IMAGE_TAG=latest
GITLAB_PORT=8929
GITLAB_SSH_PORT=2224
GITLAB_ROOT_PASSWORD=ReviewDemo2026Pass

# Filled in automatically by scripts/bootstrap.sh
GITLAB_TOKEN=
GITLAB_ADMIN_TOKEN=
GITLAB_WEBHOOK_SECRET=change-me-webhook-secret
GITLAB_BOT_USERNAME=ai-reviewer

# ---------------------------------------------------------------- Ollama (runs on the HOST)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_NUM_CTX=12288
OLLAMA_NUM_PREDICT=2048
OLLAMA_TIMEOUT_S=900

# ---------------------------------------------------------------- Infra
POSTGRES_PASSWORD=reviewer
AGENT_PORT=8080
LOG_LEVEL=INFO
INSTALL_SEMGREP=true

# ---------------------------------------------------------------- Review behaviour
MAX_FILES_PER_REVIEW=30
MAX_PROMPT_CHARS=18000
MAX_INLINE_COMMENTS=25
MIN_CONFIDENCE=0.6
INLINE_MIN_SEVERITY=low
REVIEW_DRAFTS=false
USE_LLM_SUMMARY=true
STATIC_ANALYSIS_ENABLED=true
# Optional extra Semgrep rule packs (needs internet), e.g. p/default,p/owasp-top-ten
SEMGREP_EXTRA_CONFIG=

# ---------------------------------------------------------------- Quality gate
GATE_MODE=enforce
GATE_MAX_CRITICAL=0
GATE_MAX_HIGH=0
GATE_MAX_MEDIUM=5
GATE_ON_ERROR=pass
